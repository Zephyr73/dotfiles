#!/bin/bash

# omarchy:summary=Generate Firefox userChrome/userContent CSS from the current Omarchy palette
# omarchy:args=[theme-slug]
# omarchy:hidden=true

set -euo pipefail

command -v omarchy-theme-color >/dev/null || exit 0
[[ -d $HOME/.config/mozilla/firefox ]] || exit 0

get() {
  omarchy-theme-color "$1" 2>/dev/null || echo "$2"
}

ACC=$(get accent "#7aa2f7")
BG=$(get background "#1a1b26")
BG_DARK=$(get darker_background "#0e0e14")
BG_LIGHT=$(get lighter_background "#24283b")
FG=$(get foreground "#a9b1d6")
FG_DIM=$(get dark_foreground "#565f89")
SEL=$(get selection "#292e42")

read -r MODE < <(omarchy-theme-color --file "$HOME/.local/state/omarchy/current/theme/colors.toml" mode 2>/dev/null || echo dark)
COLOR_SCHEME=$([[ $MODE == light ]] && echo light || echo dark)

CHROME_CSS=$(cat <<EOF
/* Generated by omarchy firefox-theme-sync - edits will be overwritten */
:root {
  --uc-accent: $ACC;
  --uc-bg: $BG;
  --uc-bg-dark: $BG_DARK;
  --uc-bg-light: $BG_LIGHT;
  --uc-fg: $FG;
  --uc-fg-dim: $FG_DIM;
  --uc-sel: $SEL;
}

#navigator-toolbox {
  background-color: var(--uc-bg) !important;
}

#TabsToolbar .tab-background:not([selected], [multiselected]) {
  background-color: transparent !important;
}
#TabsToolbar .tab-background:not([selected], [multiselected]):hover {
  background-color: var(--uc-sel) !important;
}
#TabsToolbar .tab-background[selected] {
  background-color: var(--uc-bg-light) !important;
}
.tab-content {
  color: var(--uc-fg) !important;
}
.tab-background[selected] .tab-content {
  color: var(--uc-accent) !important;
}
.tab-line {
  background-color: var(--uc-accent) !important;
}

#urlbar {
  background-color: var(--uc-bg-dark) !important;
  color: var(--uc-fg) !important;
}
#urlbar[focused] {
  border-color: var(--uc-accent) !important;
}
#urlbar-results {
  background-color: var(--uc-bg) !important;
}

#PersonalToolbar {
  background-color: var(--uc-bg) !important;
  color: var(--uc-fg) !important;
}

.browser-toolbar .toolbarbutton-1 {
  color: var(--uc-fg) !important;
}

#sidebar-box,
.sidebar-panel {
  background-color: var(--uc-bg) !important;
  color: var(--uc-fg) !important;
}

findbar {
  background-color: var(--uc-bg-light) !important;
  color: var(--uc-fg) !important;
}

menupopup {
  background-color: var(--uc-bg-light) !important;
  color: var(--uc-fg) !important;
}
EOF
)

CONTENT_CSS=$(cat <<EOF
/* Generated by omarchy firefox-theme-sync - edits will be overwritten */
@-moz-document url-prefix("about:home"), url-prefix("about:newtab") {
  body {
    background-color: $BG !important;
    color: $FG !important;
    color-scheme: $COLOR_SCHEME;
  }
  .search-wrapper input {
    background-color: $BG_LIGHT !important;
    color: $FG !important;
  }
  .card,
  .top-site-outer {
    background-color: $BG_LIGHT !important;
  }
}

@-moz-document url("about:blank") {
  html {
    background-color: $BG !important;
    color-scheme: $COLOR_SCHEME;
  }
}
EOF
)

shopt -s nullglob
for profile in "$HOME"/.config/mozilla/firefox/*/; do
  [[ -f ${profile}prefs.js ]] || continue
  mkdir -p "${profile}chrome"
  printf '%s\n' "$CHROME_CSS" >"${profile}chrome/userChrome.css"
  printf '%s\n' "$CONTENT_CSS" >"${profile}chrome/userContent.css"
done
