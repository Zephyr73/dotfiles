#!/bin/bash

# omarchy:summary=Sync Firefox glass theme accent to the active Omarchy palette
# omarchy:args=[theme-slug]
# omarchy:hidden=true

set -euo pipefail

BASE_DIR="$HOME/.config/omarchy/firefox"
BASE_CHROME="$BASE_DIR/base.userChrome.css"
BASE_CONTENT="$BASE_DIR/base.userContent.css"
FF_DIR="$HOME/.config/mozilla/firefox"
STATE_FILE="$HOME/.local/state/omarchy/firefox-accent"

# Bail out silently if the pieces aren't present (e.g. on a fresh install
# before Firefox or the repo checkout exist).
[[ -f "$BASE_CHROME" ]] || exit 0
[[ -d "$FF_DIR" ]] || exit 0
command -v omarchy-theme-color >/dev/null || exit 0

# Current accent from the active Omarchy palette; fall back to Tokyo Night blue.
ACC_HEX=$(omarchy-theme-color accent 2>/dev/null || echo "#a9b1d6")
ACC_HEX=${ACC_HEX#\#}
if [[ ${#ACC_HEX} -eq 3 ]]; then
  ACC_HEX="${ACC_HEX:0:1}${ACC_HEX:0:1}${ACC_HEX:1:1}${ACC_HEX:1:1}${ACC_HEX:2:1}${ACC_HEX:2:1}"
fi
ACC_RGB=$((16#${ACC_HEX:0:2}))" "$((16#${ACC_HEX:2:2}))" "$((16#${ACC_HEX:4:2}))

# Stamp the accent into the base Chrome CSS and emit the per-profile file.
emit_chrome() {
  sed "s/--uc-accent-rgb: .*/--uc-accent-rgb: $ACC_RGB;/" "$BASE_CHROME"
}

# Per-profile <userContent.css> is fully static; copy as-is.
shopt -s nullglob
for profile in "$FF_DIR"/*/; do
  [[ -f "${profile}prefs.js" ]] || continue
  chrome_dir="${profile}chrome"
  mkdir -p "$chrome_dir"
  emit_chrome >"$chrome_dir/userChrome.css"
  cp "$BASE_CONTENT" "$chrome_dir/userContent.css"
done

# Reload Firefox so the new accent shows. Restart only when the accent actually
# changed (avoids killing Firefox on every theme-set, e.g. re-selecting the
# current theme), and only if Firefox is running.
if [[ -n "$ACC_RGB" ]]; then
  PREV_ACC=""
  [[ -f "$STATE_FILE" ]] && PREV_ACC=$(cat "$STATE_FILE")

  if [[ "$PREV_ACC" != "$ACC_RGB" ]]; then
    mkdir -p "$(dirname "$STATE_FILE")"
    printf '%s\n' "$ACC_RGB" >"$STATE_FILE"

    if pgrep -x firefox >/dev/null; then
      # Graceful quit (SIGINT) so Firefox writes its session store — with
      # browser.sessionstore.resume_from_crash=false a plain kill would lose
      # open tabs. The clean quit + browser.startup.page=3 restores them.
      pkill -INT -x firefox
      for _ in $(seq 1 20); do
        pgrep -x firefox >/dev/null || break
        sleep 0.5
      done
      setsid uwsm-app -- firefox >/dev/null 2>&1 &
    fi
  fi
fi
